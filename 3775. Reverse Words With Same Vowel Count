class Solution {
    public boolean isVowel(Character c){
        if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U'){
            return true;
        }
        return false;
    }
    public int countVowel(String s){
        int vowel=0;
        char []ch=s.toCharArray();
        for(int i=0;i<ch.length;i++){
            if(isVowel(ch[i])){
                vowel++;
            }
        }
        return vowel;
    }
    public String reverse(String s){
        char []c=s.toCharArray();
        int start=0;
        int end=c.length-1;
        while(start<end){
            char temp=c[start];
            c[start]=c[end];
            c[end]=temp;
            start++;
            end--;
        }
        return String.valueOf(c);
    }
    public String reverseWords(String s) {
        String []words=s.split(" +");
        StringBuffer sb=new StringBuffer(words[0]+" ");
        int first_word_vowel=countVowel(words[0]);
        for(int i=1;i<words.length;i++){
            if(countVowel(words[i])==first_word_vowel){
                  sb.append(reverse(words[i]));
                  sb.append(" ");
            }else{
                sb.append(words[i]);
                sb.append(" ");
            }
        }
        return sb.toString().trim();
    }
}
